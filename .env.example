# ReLoop configuration. Spring Boot does NOT read .env files by itself:
# set these as environment variables (IntelliJ: Run > Edit Configurations > Environment variables,
# or PowerShell: $env:DB_PASSWORD="..." before running mvn). Never commit real values.

# --- Database (spring.datasource.*) ---
DB_URL=jdbc:mysql://localhost:3306/reloop?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me

# --- Security (reloop.jwt.*, reloop.cookie-secure, reloop.cors-origins) ---
# At least 32 random characters. If empty, a random key is generated at startup (tokens die on restart).
JWT_SECRET=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
COOKIE_SECURE=false          # true when served over HTTPS
CORS_ORIGINS=http://localhost:5173

# --- First administrator (reloop.admin.*) ---
# Created at startup only if no ADMIN exists. There is no public admin sign-up.
RELOOP_ADMIN_EMAIL=
RELOOP_ADMIN_PASSWORD=       # min 8 characters

# --- Demo data (reloop.seed-demo-data). Local development only! ---
SEED_DEMO_DATA=true

# --- Files (reloop.upload-dir, reloop.public-base-url) ---
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:5173   # used inside QR codes

# --- Optional: Cloudinary (public images). Empty = local disk fallback ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional: Razorpay. Empty = online payment hidden, COD still works ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
